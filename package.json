{
  "name": "mysql_handler",
  "version": "2.0.0",
  "description": "Database Manager — TypeScript edition",
  "private": true,
  "license": "MIT",
  "author": "mmar58",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "backend": "cd backend && pnpm dev",
    "frontend": "cd frontend && pnpm dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "start": "pnpm --filter backend start",
    "test": "pnpm --filter backend test",
    "test:coverage": "pnpm --filter backend test:coverage"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  }
}