# Server Configuration
PORT=3000

# CORS Configuration
CORS_ORIGIN=*

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-secret

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret

# Encryption pepper (generates machine-specific key salt)
CRYPT_PEPPER=change-me-to-a-random-pepper

# Database Connection Timeout (in milliseconds)
DB_CONNECTION_TIMEOUT=60000

# Application Settings
MAX_ROWS_PER_PAGE=1000
DEFAULT_PAGE_SIZE=100
